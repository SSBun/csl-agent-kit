      "expected_level": "R0",
      "expected_entry": "Skipped",
      "expected_task_review": false,
      "expected_terminal": "Skipped"
    },
    {
      "id": "simple-file-change",
      "task": "Rename one low-risk local file after checking every reference and the resulting paths.",
      "deliverable_files_changed": true,
      "simple": true,
      "r1_grounds": { "clarity": true, "impact": true, "risk": true, "verification": true },
      "expected_level": "R1",
      "expected_entry": "Skipped",
      "expected_task_review": false,
      "expected_terminal": "Skipped"
    },
    {
      "id": "small-logic-change",
      "task": "Change a presentation-only conditional; all callers, both output branches and preserved behavior are verified.",
      "deliverable_files_changed": true,
      "simple": true,
      "r1_grounds": { "clarity": true, "impact": true, "risk": true, "verification": true },
      "expected_level": "R1",
      "expected_entry": "Skipped",
      "expected_task_review": false,
      "expected_terminal": "Skipped"
    },
    {
      "id": "many-mechanical-files",
      "task": "Apply the same settled low-risk label substitution across many files and verify the complete replacement scope.",
      "deliverable_files_changed": true,
      "simple": true,
      "r1_grounds": { "clarity": true, "impact": true, "risk": true, "verification": true },
      "expected_level": "R1",
      "expected_entry": "Skipped",
      "expected_task_review": false,
      "expected_terminal": "Skipped"
    },
    {
      "id": "complex-file-change",
      "task": "Migrate persistent directives across three hosts with interacting routing changes.",
      "deliverable_files_changed": true,
      "simple": false,
      "expected_level": "R2",
      "expected_entry": "Required",
      "expected_task_review": true,
      "expected_terminal": "Passed"
    },
    {
      "id": "critical-file-change",
      "task": "Change one production authorization condition; a one-line diff is not low risk.",
      "deliverable_files_changed": true,
      "simple": true,
      "r1_grounds": { "clarity": true, "impact": true, "risk": false, "verification": true },
      "expected_level": "R2",
      "expected_entry": "Required",
      "expected_task_review": true,
      "expected_terminal": "Passed"
    },
    {
      "id": "uncertain-consumers",
      "task": "Make a small logic change whose indirect consumers have not been bounded.",
      "deliverable_files_changed": true,
      "simple": true,
      "r1_grounds": { "clarity": true, "impact": false, "risk": true, "verification": true },
      "expected_level": "R2",
      "expected_entry": "Required",
      "expected_task_review": true,
      "expected_terminal": "Passed"
    },
    {
      "id": "syntax-only-evidence",
      "task": "Only syntax has been checked; preserved behavior is not established by that observation.",
      "deliverable_files_changed": true,
      "simple": true,
      "r1_grounds": { "clarity": true, "impact": true, "risk": true, "verification": false },
      "expected_level": "R2",
      "completion_requires_missing_evidence": true,
      "expected_entry": "Required",
      "expected_task_review": true,
      "expected_terminal": "Passed"
    },
    {
      "id": "workflow-mandated-review",
      "task": "Finish a simple low-risk change with an independent review explicitly required for this outcome.",
      "deliverable_files_changed": true,
      "simple": true,
      "r1_grounds": { "clarity": true, "impact": true, "risk": true, "verification": true },
      "user_requested_ordinary_review": true,
      "expected_level": "R1",
      "expected_entry": "Required",
      "expected_task_review": true,
      "expected_terminal": "Passed"
    },
    {
      "id": "ordinary-one-pass-review",
      "task": "Review this pull request once without modifying it; do not recursively review the feedback.",
      "deliverable_files_changed": false,
      "expected_level": "R0",
      "expected_entry": "Skipped",
      "expected_task_review": false,
      "expected_terminal": "Skipped"
    },
    {
      "id": "explicit-adversarial-file-change",
      "task": "Make a complex change, then run explicitly requested adversarial-review after the ordinary R2 pass.",
      "deliverable_files_changed": true,
      "simple": false,
      "user_requested_adversarial_review": true,
      "expected_level": "R2",
      "expected_entry": "Required",
      "expected_task_review": true,
      "expected_terminal": "Approved"
    },
    {
      "id": "explicit-adversarial-low-risk",
      "task": "Run explicitly requested adversarial-review on a fully verified low-risk change, without an automatic ordinary pass.",
      "deliverable_files_changed": true,
      "simple": true,
      "r1_grounds": { "clarity": true, "impact": true, "risk": true, "verification": true },
      "user_requested_adversarial_review": true,
      "expected_level": "R1",
      "expected_entry": "Required",
      "expected_task_review": false,
      "expected_terminal": "Approved"
    },
    {
      "id": "explicit-adversarial-no-file-queue",
      "task": "Run adversarial-review on a Queue parent's no-file integration result.",
