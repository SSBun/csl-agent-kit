{
  "cases": [
    {
      "id": "no-file-result",
      "task": "Complete a research result without changing requested deliverable files.",
      "deliverable_files_changed": false,
      "user_requested_adversarial_review": false,
      "expected_entry": "Skipped",
      "expected_task_review": false,
      "expected_terminal": "Skipped"
    },
    {
      "id": "simple-file-change",
      "task": "Rename one verified local file.",
      "deliverable_files_changed": true,
      "user_requested_adversarial_review": false,
      "expected_entry": "Required",
      "expected_task_review": true,
      "expected_terminal": "Passed"
    },
    {
      "id": "complex-file-change",
      "task": "Migrate persistent directives across three hosts.",
      "deliverable_files_changed": true,
      "user_requested_adversarial_review": false,
      "expected_entry": "Required",
      "expected_task_review": true,
      "expected_terminal": "Passed"
    },
    {
      "id": "critical-file-change",
      "task": "Change production authentication and permission behavior.",
      "deliverable_files_changed": true,
      "user_requested_adversarial_review": false,
      "expected_entry": "Required",
      "expected_task_review": true,
      "expected_terminal": "Passed"
    },
    {
      "id": "workflow-mandated-review",
      "task": "Finish a file-changing task under the mandatory task-review policy.",
      "deliverable_files_changed": true,
      "user_requested_adversarial_review": false,
      "expected_entry": "Required",
      "expected_task_review": true,
      "expected_terminal": "Passed"
    },
    {
      "id": "ordinary-one-pass-review",
      "task": "Review this pull request once without modifying it.",
      "deliverable_files_changed": false,
      "user_requested_adversarial_review": false,
      "expected_entry": "Skipped",
      "expected_task_review": false,
      "expected_terminal": "Skipped"
    },
    {
      "id": "explicit-adversarial-file-change",
      "task": "Change files, then run adversarial-review before completion.",
      "deliverable_files_changed": true,
      "user_requested_adversarial_review": true,
      "expected_entry": "Required",
      "expected_task_review": true,
      "expected_terminal": "Approved"
    },
    {
      "id": "explicit-adversarial-no-file-queue",
      "task": "Run adversarial-review on a Queue parent's no-file integration result.",
      "kind": "queue",
      "deliverable_files_changed": false,
      "user_requested_adversarial_review": true,
      "expected_entry": "Required",
      "expected_task_review": false,
      "expected_terminal": "Approved"
    },
    {
      "id": "explicit-adversarial-no-file-result",
      "task": "Run adversarial-review on this no-file research result.",
      "deliverable_files_changed": false,
      "user_requested_adversarial_review": true,
      "expected_entry": "Required",
      "expected_task_review": false,
      "expected_terminal": "Approved"
    }
  ]
}
