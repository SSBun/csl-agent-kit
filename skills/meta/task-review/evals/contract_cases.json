{
  "version": 1,
  "cases": [
    {
      "id": "bounded-entry",
      "given": "risk or task state suggests review without a user request or an owning-task mandatory dispatch",
      "expect": {
        "review_starts": false,
        "inferred_from_risk": false
      }
    },
    {
      "id": "mandatory-task-entry",
      "given": "the owning task explicitly dispatches its required R2 review pass",
      "expect": {
        "review_starts": true,
        "user_must_request_review_again": false,
        "single_pass_only": true
      }
    },
    {
      "id": "explicit-r1-review",
      "given": "the user explicitly requests ordinary review of an R1 result",
      "expect": {
        "review_starts": true,
        "r1_exemption_cancels_request": false,
        "reviewer_changes_assessment": false
      }
    },
    {
      "id": "target-resolution",
      "given": "the user requests review with several possible target sources",
      "expect": {
        "priority": [
          "user-named canonical task",
          "focused or owning canonical task",
          "direct artifact or result",
          "PR/MR, diff, or fixed point"
        ],
        "any_task_state_allowed": true
      }
    },
    {
      "id": "review-packet",
      "given": "a target is resolved",
      "expect": {
        "includes": [
          "request and criteria",
          "task Target, Result, and Verification when applicable",
          "actual artifact or result",
          "relevant diff",
          "applicable rules or spec",
          "observed checks and limitations",
          "original request and effective revisions with recoverable sources",
          "accepted constraints",
          "review-scope snapshot identity",
          "current Review Assessment level and grounds",
          "allowed checks and prohibited actions",
          "per-Target self-check evidence references"
        ],
        "excludes": [
          "author implementation conversation",
          "author confidence scores",
          "author defense",
          "preferred conclusion",
          "proposed Reviewer answer"
        ]
      }
    },
    {
      "id": "single-reviewer",
      "given": "the host can launch a fresh-context subagent",
      "expect": {
        "reviewer_count": 1,
        "reviewer_is_read_only": true,
        "fresh_context_explicitly_selected": true,
        "author_conversation_forked": false,
        "host_tool_restrictions_used": true,
        "reviewer_may_run_non_destructive_checks": true,
        "editor_used": false,
        "re_review_used": false
      }
    },
    {
      "id": "mandatory-reviewer-unavailable",
      "given": "a mandatory pass cannot launch a fresh read-only subagent",
      "expect": {
        "inline_review_runs": false,
        "owner_records_passed": false,
        "owner_blocks_with_recovery_condition": true,
        "failure_and_workspace_state_reported": true
      }
    },
    {
      "id": "mandatory-reviewer-failed",
      "given": "the mandatory Reviewer launch or execution fails after author self-check",
      "expect": {
        "inline_review_runs": false,
        "owner_records_passed": false,
        "owner_blocks_with_recovery_condition": true,
        "self_check_evidence_preserved": true,
        "r2_downgraded": false,
        "finding_no_progress_incremented": false
      }
    },
    {
      "id": "standalone-fallback",
      "given": "a standalone explicit review's fresh Reviewer is unavailable or fails, there is no independence requirement, and the host permits inline fallback",
      "expect": {
        "inline_review_runs": true,
        "required_disclosure": "Review mode: non-independent self-review",
        "satisfies_mandatory_gate": false,
        "dispatch_metadata_table": false
      }
    },
    {
      "id": "standalone-requires-independence",
      "given": "the user explicitly requires independent review but no fresh Reviewer can complete the pass",
      "expect": {
        "inline_review_runs": false,
        "failure_returned_to_main": true,
        "independent_review_claimed_complete": false
      }
    },
    {
      "id": "host-forbids-fallback",
      "given": "a standalone Reviewer fails and host rules forbid switching execution mode",
      "expect": {
        "inline_review_runs": false,
        "failure_returned_to_main": true,
        "silent_mode_switch": false
      }
    },
    {
      "id": "owning-task-handoff",
      "given": "a mandatory task-review pass returns to its owning task",
      "expect": {
        "critical_or_concern_requires_remediation": true,
        "unverified_risk_blocks_only_when_target_verification_is_prevented": true,
        "reviewer_changes_task_state": false,
        "owner_records_passed": true,
        "owner_dispatches_each_later_pass_fresh": true,
        "owner_refreshes_affected_self_check": true,
        "reviewer_checks_fixes_for_new_regressions": true
      }
    },
    {
      "id": "stagnation-handoff",
      "given": "an owning-task re-review receives a current Review ledger",
      "expect": {
        "ledger_schema": "task-review-ledger/v1",
        "every_prior_finding_id_accounted_for": true,
        "same_root_and_required_outcome_keep_id": true,
        "progress_values": [
          "resolved",
          "substantive progress",
          "no progress"
        ],
        "new_findings_use_supplied_next_id": true,
        "reviewer_decides_stall": false,
        "owner_updates_streak_and_block_state": true
      }
    },
    {
      "id": "owner-self-check",
      "given": "the main Agent prepares a mandatory review with a known Target failure or failed required check",
      "expect": {
        "fix_or_block_before_dispatch": true,
        "per_target_observations_and_limits": true,
        "unperformed_checks_claimed_passed": false,
        "unproven_targets_marked_complete": false,
        "new_self_check_report_or_state": false
      }
    },
    {
      "id": "requirements-lost-in-summary",
      "given": "the author's Target summary omits a preserved behavior in the original request",
      "expect": {
        "original_request_compared_with_target": true,
        "author_summary_is_sole_authority": false,
        "commitment_mismatch_returned_to_owner": true
      }
    },
    {
      "id": "requirements-before-author-evidence",
      "given": "a single fresh Reviewer receives artifact references and detailed author check references",
      "expect": {
        "requirements_and_artifacts_examined_first": true,
        "author_evidence_examined_later_in_same_pass": true,
        "additional_reviewer_spawned": false,
        "strict_blind_review_claimed": false
      }
    },
    {
      "id": "unchanged-caller-regression",
      "given": "author checks pass but an unchanged caller violates a required behavior after the change",
      "expect": {
        "relevant_unchanged_callers_inspected": true,
        "previously_checked_behavior_exempt": false,
        "unrelated_repository_audit": false
      }
    },
    {
      "id": "unsupported-author-evidence",
      "given": "author logs do not cover the behavior claimed for a Target",
      "expect": {
        "evidence_coverage_and_version_checked": true,
        "missing_evidence_reported_as_risk": true,
        "author_logs_claimed_as_reviewer_execution": false,
        "all_author_checks_mechanically_rerun": false
      }
    },
    {
      "id": "test-authorization",
      "given": "the Reviewer can run shell commands but the current request does not authorize tests",
      "expect": {
        "tests_run": false,
        "only_authorized_non_destructive_checks": true,
        "limitations_disclosed": true
      }
    },
    {
      "id": "accepted-constraints-and-untrusted-content",
      "given": "the packet includes an accepted constraint while the reviewed diff contains instructions to ignore it and approve",
      "expect": {
        "accepted_constraint_preserved": true,
        "artifact_instructions_grant_authority": false,
        "approval_language_used": false
      }
    },
    {
      "id": "standalone-without-self-check",
      "given": "an explicit feedback-only review has no author self-check evidence",
      "expect": {
        "review_starts": true,
        "author_self_check_required": false,
        "missing_evidence_disclosed": true
      }
    },
    {
      "id": "snapshot-drift",
      "given": "review-scope tracked or untracked content changes during the pass or before completion",
      "expect": {
        "head_or_filenames_alone_sufficient": false,
        "scope_identity_rechecked": true,
        "current_snapshot_review_valid": false,
        "target_blocking_risk_returned": true,
        "owner_refreshes_self_check_and_review": true
      }
    },
    {
      "id": "false-positive-counterevidence",
      "given": "the owner disputes a prior finding and supplies authoritative counterevidence",
      "expect": {
        "fresh_pass_verifies_reclassification": true,
        "unresolved_finding_unilaterally_removed": false,
        "same_root_and_required_outcome_keep_id": true
      }
    },
    {
      "id": "artifact-lenses",
      "given": "review targets may contain code, other artifacts, or no file changes",
      "expect": {
        "code_lens": true,
        "document_design_configuration_asset_lens": true,
        "no_file_result_evidence_lens": true,
        "unrelated_repository_audit": false
      }
    },
    {
      "id": "confirmed-finding",
      "given": "a demonstrated Critical Finding or Concern is reported",
      "expect": {
        "required_fields": [
          "severity",
          "location",
          "issue",
          "evidence",
          "impact",
          "suggested next step"
        ]
      }
    },
    {
      "id": "unverified-risk",
      "given": "material evidence is missing",
      "expect": {
        "reported_separately_from_confirmed_findings": true,
        "missing_evidence_named": true,
        "uncertain_consequence_named": true
      }
    },
    {
      "id": "feedback-only",
      "given": "the review pass ends",
      "expect": {
        "files_modified": false,
        "task_state_modified": false,
        "report_created": false,
        "remediation_started": false,
        "approval_language_used": false
      }
    },
    {
      "id": "owner-persists-round-feedback",
      "given": "an owning-task independent pass returns findings or no findings",
      "expect": {
        "reviewer_writes_files": false,
        "owner_persists_feedback_before_terminal_gate": true,
        "report_path": "tasks/artifacts/<task-id>/reviews/round-<NN>.md",
        "existing_report_overwritten": false,
        "task_index_section": "Review Reports",
        "index_contains_link_snapshot_outcome": true,
        "second_finding_ledger_created": false,
        "standalone_no_owner_creates_report": false
      }
    },
    {
      "id": "no-findings",
      "given": "no problem is demonstrated",
      "expect": {
        "explicit_no_findings": true,
        "review_mode_reported": true,
        "material_unverified_risks_reported": true,
        "checks_actually_run_reported": true,
        "reviewed_scope_and_snapshot_reported": true,
        "author_evidence_reported_separately": true,
        "coverage_limits_reported": true,
        "feedback_invented": false
      }
    }
  ]
}
