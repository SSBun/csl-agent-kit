{
  "version": 1,
  "cases": [
    {
      "id": "accepted-inputs",
      "given": "the user supplies a PR, MR, diff, current worktree, or fixed comparison point",
      "expect": {
        "all_are_valid_review_inputs": true,
        "fixed_point_always_required": false
      }
    },
    {
      "id": "missing-spec",
      "given": "no product spec can be found for an ordinary code review",
      "expect": {
        "review_continues": true,
        "spec_lens": "skipped with boundary",
        "user_question_required": false
      }
    },
    {
      "id": "review-order",
      "given": "the diff contains a security bug and a style concern",
      "expect": {
        "correctness_security_first": true,
        "severity_ordered": true,
        "preference_only_feedback": false
      }
    },
    {
      "id": "finding-contract",
      "given": "a demonstrated issue is reported",
      "expect": {
        "required_fields": [
          "lens",
          "file:line",
          "impact",
          "evidence",
          "fix"
        ]
      }
    },
    {
      "id": "standards-evidence",
      "given": "a standards violation is reported",
      "expect": {
        "documented_rule_cited": true,
        "local_rule_overrides_fallback": true,
        "general_smell_is_judgment_call": true
      }
    },
    {
      "id": "no-findings",
      "given": "the reviewed diff has no demonstrated issues",
      "expect": {
        "explicit_no_findings": true,
        "material_boundaries_listed": true,
        "feedback_invented": false
      }
    },
    {
      "id": "ordinary-review-boundary",
      "given": "the user requests a normal code review",
      "expect": {
        "parallel_subagents_required": false,
        "adversarial_approval_required": false
      }
    }
  ]
}
